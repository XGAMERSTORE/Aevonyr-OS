#!/bin/sh
set -eu
WALLPAPER=/usr/share/backgrounds/aevonyr/aevonyr-neon.svg
STATE="$HOME/.local/state/aevonyr"
MARKER="$STATE/wallpaper-applied-v1"
[ -e "$MARKER" ] && exit 0
command -v plasma-apply-wallpaperimage >/dev/null 2>&1 || exit 0
[ -r "$WALLPAPER" ] || exit 0
mkdir -p "$STATE"
attempt=0
while [ "$attempt" -lt 8 ]; do
    if plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null 2>&1; then
        : > "$MARKER"
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
done
exit 0
